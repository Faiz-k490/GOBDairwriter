# Air Writer — email credentials.  Copy to `.env` and fill in.
# `.env` is gitignored: it holds a real password. Never commit it.
#
# ── Getting a Gmail app password (5 minutes) ────────────────────────────
# 1. Turn on 2-Step Verification:  https://myaccount.google.com/security
#    App passwords do not exist without it.
# 2. Create one named "Air Writer": https://myaccount.google.com/apppasswords
# 3. Paste the 16 characters below (spaces are fine, they get stripped).
#
# A consumer Gmail account is capped near 500 recipients/day — fine for a
# fair.  Prefer a club account over a personal one.

AIRWRITER_SMTP_USER=you@gmail.com
AIRWRITER_SMTP_PASS=xxxxxxxxxxxxxxxx

# Shown as the sender name.
AIRWRITER_FROM_NAME=Air Writer

# Where replies go.  Optional — defaults to AIRWRITER_SMTP_USER.
AIRWRITER_REPLY_TO=

# Appears in the email body.  Optional.
AIRWRITER_CLUB_NAME=

# 0 = collect addresses to disk but never send.  Use this to demo the flow
# without mailing anyone, and to run the test harness offline.
AIRWRITER_ENABLED=1
